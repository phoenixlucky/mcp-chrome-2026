{
  "name": "mcp-chrome-bridge-monorepo-2026",
  "version": "2.5.2",
  "private": true,
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=24"
  },
  "author": "hangye",
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @ethanwilkins/chrome-mcp-shared-2026 build",
    "build:native": "pnpm --filter @ethanwilkins/mcp-chrome-bridge-2026 build",
    "build:extension": "pnpm --filter @ethanwilkins/chrome-mcp-server-2026 build",
    "build:desktop": "pnpm --filter @ethanwilkins/chrome-mcp-desktop-2026 build",
    "build:wasm": "pnpm --filter @chrome-mcp/wasm-simd build && pnpm run copy:wasm",
    "build:release": "pnpm run build:wasm && pnpm run build",
    "package:windows": "pnpm run check:versions && node scripts/package-windows.mjs",
    "package:desktop:windows": "pnpm run package:windows && node scripts/prepare-tauri-bridge.mjs && pnpm --filter @ethanwilkins/chrome-mcp-desktop-2026 tauri:build",
    "build": "pnpm -r --filter=!@chrome-mcp/wasm-simd build",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "dev:shared": "pnpm --filter @ethanwilkins/chrome-mcp-shared-2026 dev",
    "dev:native": "pnpm --filter @ethanwilkins/mcp-chrome-bridge-2026 dev",
    "dev:extension": "pnpm --filter @ethanwilkins/chrome-mcp-server-2026 dev",
    "dev:desktop": "pnpm --filter @ethanwilkins/chrome-mcp-desktop-2026 tauri:dev",
    "dev": "pnpm --filter @ethanwilkins/chrome-mcp-shared-2026 build && pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "check:tool-docs": "node scripts/check-tool-docs.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "sync:tool-docs": "node scripts/sync-tool-docs.mjs",
    "test:chrome-smoke": "node scripts/chrome-smoke.mjs",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "clean:dist": "pnpm -r exec rm -rf dist .turbo",
    "clean:modules": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean": "npm run clean:dist && npm run clean:modules",
    "typecheck": "pnpm run typecheck:shared && pnpm run build:shared && pnpm run typecheck:native && pnpm run typecheck:extension",
    "typecheck:shared": "pnpm exec tsc --noEmit -p packages/shared/tsconfig.json",
    "typecheck:native": "pnpm exec tsc --noEmit -p app/native-server/tsconfig.json",
    "typecheck:extension": "pnpm --filter @ethanwilkins/chrome-mcp-server-2026 run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.25.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vue-eslint-parser": "^10.1.3"
  },
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,html,css}": [
      "prettier --write"
    ]
  }
}
