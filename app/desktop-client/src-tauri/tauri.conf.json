{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chrome MCP Bridge",
  "version": "2.6.7",
  "identifier": "com.chromemcp.bridge.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chrome MCP Bridge",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": ["../bridge/*"],
    "icon": ["icons/icon.ico"]
  }
}
