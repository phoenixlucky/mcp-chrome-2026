{
  "name": "@ethanwilkins/chrome-mcp-server-2026",
  "description": "a chrome extension to use your own chrome as a mcp server",
  "author": "hangye",
  "private": true,
  "version": "2.7.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "postzip": "node scripts/postzip.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "vue-tsc --noEmit",
    "compile": "pnpm run typecheck",
    "postinstall": "node -e \"try{require('child_process').execSync('wxt prepare',{cwd:__dirname,shell:true,stdio:'inherit'})}catch(e){}\"",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ethanwilkins/chrome-mcp-shared-2026": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.47.0",
    "@vue-flow/minimap": "^1.5.4",
    "@xenova/transformers": "^2.17.2",
    "date-fns": "^4.1.0",
    "elkjs": "^0.11.0",
    "gifenc": "^1.0.3",
    "hnswlib-wasm-static": "0.8.5",
    "markstream-vue": "0.0.3-beta.5",
    "vue": "^3.5.42",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.130",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.318",
    "@wxt-dev/module-vue": "^1.0.3",
    "dotenv": "^17.4.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.2",
    "unplugin-icons": "^0.19.0",
    "unplugin-vue-components": "^0.27.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
