{
  "name": "@ethanwilkins/mcp-chrome-bridge-2026",
  "version": "2.4.1",
  "description": "Chrome Native-Messaging host (Node)",
  "main": "dist/index.js",
  "bin": {
    "mcp-chrome-bridge": "./dist/cli.js",
    "chrome-mcp-bridge": "./dist/cli.js",
    "mcp-chrome-stdio": "./dist/mcp/mcp-server-stdio.js"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --ignore dist/ --exec \"npm run build && npm run register:dev\"",
    "prebuild": "pnpm --filter @ethanwilkins/chrome-mcp-shared-2026 build",
    "build": "ts-node src/scripts/build.ts",
    "prepack": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "register:dev": "node dist/scripts/register-dev.js",
    "postinstall": "node -e \"try{require('./dist/scripts/postinstall.js')}catch(e){if(e.code!=='MODULE_NOT_FOUND')throw e}\""
  },
  "files": [
    "dist",
    "!dist/node_path.txt",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "preferGlobal": true,
  "keywords": [
    "mcp",
    "chrome",
    "browser"
  ],
  "author": "hangye",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.69",
    "@fastify/cors": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.1.0",
    "chrome-devtools-frontend": "^1.0.1299282",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.2",
    "is-admin": "^4.0.0"
  },
  "devDependencies": {
    "@ethanwilkins/chrome-mcp-shared-2026": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/chrome": "^0.0.318",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.31.1",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
